# Copy to .env and adjust. Firebase Admin still needs serviceAccountKey.json.

# Google Cloud project id (same as Firebase project)
FIREBASE_PROJECT_ID=coffe-detect

# GCS bucket id used by Firebase Storage (Console → Storage shows the bucket name).
# Often: YOUR_PROJECT_ID.appspot.com
# If Storage is not enabled or billing is off, diagnosis still works but images are not stored.
FIREBASE_STORAGE_BUCKET=coffe-detect.appspot.com
